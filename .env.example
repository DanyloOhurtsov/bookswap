# §12.2: .env — ОДИН, у корені репозиторію.
# Скопіюй цей файл у `.env` і за потреби підправ значення.

NODE_ENV=development

# --- apps/api ---------------------------------------------------------------
# §13.1: порт застосунку через env, не хардкодом.
PORT=3001

# Адреса фронтенду. Використовується двічі: як дозволений origin для CORS і як
# основа посилань у листах (підтвердження пошти, скидання пароля) — вони ведуть
# на фронт, а не на API.
WEB_ORIGIN=http://localhost:3000

# Терміни життя сесій і одноразових токенів навмисно НЕ в оточенні: вони однакові
# в усіх середовищах і живуть константами в apps/api/src/auth/auth.constants.ts.
# Єдине, що залежить від середовища, — атрибут Secure на кукі; він виводиться
# з NODE_ENV.

# --- apps/web ---------------------------------------------------------------
# У клієнтський бандл Next потрапляють ЛИШЕ змінні з префіксом NEXT_PUBLIC_.
# Нічого секретного під цим префіксом бути не може.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- PostgreSQL (docker-compose.yml) ----------------------------------------
# Креденшели збігаються з docker-compose.yml. Обидві змінні ОБОВ'ЯЗКОВІ: API падає
# на старті без них, а `prisma generate` не запуститься без DIRECT_DATABASE_URL.
#
# §4.1: DIRECT_DATABASE_URL обов'язковий навіть коли локально дублює DATABASE_URL —
# у проді DATABASE_URL піде через PgBouncer, а міграції беруть advisory lock,
# який не переживає transaction pooling.
#
# Розподіл ролей у Prisma 7 (поля `directUrl` у datasource більше немає):
#   DATABASE_URL        — рантайм-клієнт через драйвер-адаптер @prisma/adapter-pg
#   DIRECT_DATABASE_URL — Prisma CLI: міграції, introspection, seed
DATABASE_URL=postgresql://bookswap:dev@localhost:5432/bookswap?schema=public
DIRECT_DATABASE_URL=postgresql://bookswap:dev@localhost:5432/bookswap?schema=public

# Окрема база під `pnpm test:db`. Тести дропають і створюють її заново на кожному
# прогоні, тож дані dev-бази вони не чіпають. Достатньо, щоб контейнер із
# docker-compose.yml був піднятий — саму базу створює globalSetup.
#
# УВАГА: назва мусить закінчуватися на `_test`, лежати на localhost і НЕ збігатися
# з DATABASE_URL / DIRECT_DATABASE_URL. Інакше `pnpm test:db` відмовиться стартувати
# (fail-closed перевірка в apps/api/test/db/guard.ts) — це захист від DROP DATABASE
# по чужій базі.
TEST_DATABASE_URL=postgresql://bookswap:dev@localhost:5432/bookswap_test?schema=public
