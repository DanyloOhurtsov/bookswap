{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // §12.3: rootDir живе САМЕ тут, не в базовому конфізі. У базовому він охопив би
    // ще й test/, і Jest впав би на розбіжності коренів.
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
